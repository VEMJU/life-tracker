# ============================================================================
#  KEYS — the template. This file is COMMITTED and must never hold a real key.
#
#  To use a key:
#    1. Copy this file to  .env.local   (that name is gitignored)
#    2. Paste your real key after the =
#    3. For the live site, add the same name/value in
#       Vercel → Project → Settings → Environment Variables
#
#  Rule of thumb: if a key is readable in the browser, treat it as public.
#  That is why every key below is used by a function in /api, never by the page.
# ============================================================================

# Stocks tab — live share prices.  https://finnhub.io  (free tier)
FINNHUB_API_KEY=

# Map tab — search for a place by name instead of clicking coordinates.
# https://console.cloud.google.com → enable "Places API"
GOOGLE_PLACES_API_KEY=

# Home + running routes — current conditions.  https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Nutrition tab — look up a food, get its macros.
# Free, no billing: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=
